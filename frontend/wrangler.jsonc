{
  // Cloudflare Workers with Static Assets: one deploy serves the UI and the chat proxy.
  // Secrets (not here): API_BASE_URL and PREFLIGHT_ACCESS_KEY via `wrangler secret put`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "preflight-oss-demo",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {"enabled": true},
  "workers_dev": true,
  "preview_urls": false
}
