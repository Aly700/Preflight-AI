# Configuration reference only. The current Python code reads process environment;
# it does not automatically load this file. Never put credentials in this template.
PGHOST=localhost
PGPORT=5432
PGDATABASE=preflight_oss
PGUSER=preflight_oss_api
PGPASSWORD_FILE=.secrets/api-password
CHAT_TOKEN_FILE=.secrets/chat-token
COPILOT_TOKEN_FILE=.secrets/copilot-token
MCP_TOKEN_FILE=.secrets/mcp-token
# Required: the chat API refuses to start an answer without an explicit MCP target.
PREFLIGHT_MCP_URL=http://localhost:8001/mcp
# Host headers each service accepts (comma-separated). Defaults are loopback only.
# API entries are host names without ports (a leading *. wildcard is allowed); MCP entries
# are host, host:port or host:*. In a Compose network add the service names you chose,
# for example preflight-oss-api and preflight-oss-mcp:*.
PREFLIGHT_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
# Model provider: copilot (default; needs COPILOT_TOKEN_FILE), or a bring-your-own-key
# provider, anthropic or openai, which needs MODEL_API_KEY_FILE and a COPILOT_MODEL name.
MODEL_PROVIDER=copilot
MODEL_API_KEY_FILE=.secrets/model-api-key
# MODEL_PROVIDER=bedrock requires CHAT_RUNTIME=native, a Bedrock COPILOT_MODEL ID and AWS_REGION.
# Bedrock uses the standard AWS credential chain instead of a model key file.
AWS_REGION=
# Anthropic only: a user-scoped key (sk-ant-usr-...) must name the workspace to bill; leave empty
# for a workspace-scoped key. Not a secret, but never commit a real value.
ANTHROPIC_WORKSPACE_ID=
# Chat runtime: copilot (the Copilot SDK's own loop) or native (this repository's loop over the
# Anthropic Messages API; needs MODEL_PROVIDER=anthropic or bedrock). Tool-use bounds apply to native.
CHAT_RUNTIME=copilot
MAX_TOOL_ROUNDS=6
MAX_TOOL_CALLS=12
MAX_ANSWERS_PER_DAY=200 # Daily answer cap per process (1 to 100000); resets at midnight UTC.
# Model name or Bedrock model/inference-profile ID. Optional for copilot (account-default routing);
# required for anthropic/openai/bedrock. Record the model when evaluating it.
COPILOT_MODEL=
